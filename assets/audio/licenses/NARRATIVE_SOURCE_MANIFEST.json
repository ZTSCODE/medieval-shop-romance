  "suggested_text_key_assets": {
    "OPENING_CHRONICLE_PAGE_2": {
      "text": "然后，白冬来了。春天不化的雪，直到盛夏仍是一片白的田野。\n它年复一年向这片土地蔓延，每一年都走得更远一点，夺走得更多一点。",
      "assets": [
        "ready/amb_snowline_gusts_loop.ogg"
      ]
    },
    "OPENING_CHRONICLE_PAGE_5": {
      "text": "如今，在那张地图参差的边缘，一个人正在逃命，身后是四十个骑手和他们的猎狗。\n他找到了一条线索，指向帝国唯一不能容许的东西：对抗白冬的方法。",
      "assets": [
        "ready/amb_snowline_gusts_loop.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_01": {
      "text": "肺里像着了火。脚下的地越来越软。身后某处，一条狗叫了一声，又停了。",
      "assets": [
        "ready/amb_snowline_gusts_loop.ogg",
        "ready/step_soft_grass_01.ogg",
        "ready/step_soft_grass_02.ogg",
        "ready/step_soft_grass_03.ogg",
        "ready/step_soft_grass_04.ogg",
        "ready/step_wet_earth.ogg",
        "ready/dog_bark_far.ogg",
        "ready/snow_to_soft_ground.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_04": {
      "text": "然后树木合拢过来，一片白雾横在你面前，低低的，一动不动。",
      "assets": [
        "ready/amb_thorn_forest_cold_loop.ogg",
        "ready/brush_thorns_01.ogg",
        "ready/brush_thorns_02.ogg",
        "ready/brush_thorns_03.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_05": {
      "text": "前方的雾里有东西在动。你停下。它也停下。",
      "assets": [
        "ready/amb_thorn_forest_cold_loop.ogg",
        "ready/brush_thorns_01.ogg",
        "ready/brush_thorns_02.ogg",
        "ready/brush_thorns_03.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_29": {
      "text": "那几棵树后面有条小溪。走在水里，别走岸上，一直走到林子变稀。",
      "assets": [
        "ready/amb_creek_hidden_loop.ogg"
      ]
    },
    "action:first_forest": {
      "text": null,
      "assets": [
        "ready/amb_creek_hidden_loop.ogg",
        "ready/step_shallow_water_01.ogg",
        "ready/step_shallow_water_02.ogg"
      ]
    },
    "snowline_travel": {
      "text": null,
      "assets": [
        "ready/step_snow_01.ogg",
        "ready/step_snow_02.ogg",
        "ready/step_snow_03.ogg",
        "ready/step_snow_04.ogg"
      ]
    },
    "transition:DLG_MESSENGER_EDGE_01": {
      "text": null,
      "assets": [
        "ready/step_snow_01.ogg",
        "ready/step_snow_02.ogg",
        "ready/step_snow_03.ogg",
        "ready/step_snow_04.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_07": {
      "text": "一个年轻人从雾里走出来，喘着粗气。头发上别着月桂，腰间挎着信包。",
      "assets": [
        "ready/step_soft_grass_01.ogg",
        "ready/step_soft_grass_02.ogg",
        "ready/step_soft_grass_03.ogg",
        "ready/step_soft_grass_04.ogg"
      ]
    },
    "DLG_MESSENGER_RULES_15": {
      "text": "他已经倒退着走开了，咧着嘴笑。",
      "assets": [
        "ready/step_soft_grass_01.ogg",
        "ready/step_soft_grass_02.ogg",
        "ready/step_soft_grass_03.ogg",
        "ready/step_soft_grass_04.ogg"
      ]
    },
    "DLG_MESSENGER_RULES_17": {
      "text": "然后他转身跑进了林子。",
      "assets": [
        "ready/step_soft_grass_01.ogg",
        "ready/step_soft_grass_02.ogg",
        "ready/step_soft_grass_03.ogg",
        "ready/step_soft_grass_04.ogg",
        "ready/brush_thorns_01.ogg",
        "ready/brush_thorns_02.ogg",
        "ready/brush_thorns_03.ogg",
        "ready/run_forest_depart.ogg"
      ]
    },
    "action:badger_track": {
      "text": null,
      "assets": [
        "ready/step_soft_grass_01.ogg",
        "ready/step_soft_grass_02.ogg",
        "ready/step_soft_grass_03.ogg",
        "ready/step_soft_grass_04.ogg",
        "ready/twig_snap_small.ogg"
      ]
    },
    "DLG_MESSENGER_RULES_01": {
      "text": "一个钟头后，他追了上来，膝盖以下全湿透了，一脸得意。",
      "assets": [
        "ready/step_wet_earth.ogg",
        "ready/step_shallow_water_01.ogg",
        "ready/step_shallow_water_02.ogg",
        "ready/wet_steps_arrive.ogg"
      ]
    },
    "DLG_MESSENGER_RULES_07": {
      "text": "他在一丛黑刺李边蹲下，摘了一颗果子，皱眉看了看，放进你掌心。",
      "assets": [
        "ready/berry_leaf_pluck.ogg"
      ]
    },
    "transition:forest_entry": {
      "text": null,
      "assets": [
        "ready/twig_snap_small.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_27": {
      "text": "远远的身后，狗又叫了。比刚才近。",
      "assets": [
        "ready/dog_bark_nearer.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_03": {
      "text": "你的左手抖个不停。你把它塞进外套里按住，像按住别人的手。",
      "assets": [
        "ready/scarf_cloth_01.ogg",
        "ready/scarf_cloth_02.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_32": {
      "text": "你把围巾递给他。他一句话没说，绕在了自己脖子上。",
      "assets": [
        "ready/scarf_cloth_01.ogg",
        "ready/scarf_cloth_02.ogg"
      ]
    },
    "DLG_MESSENGER_RULES_03": {
      "text": "他把围巾还给你。围巾被他的脖子捂得还是暖的。",
      "assets": [
        "ready/scarf_cloth_01.ogg",
        "ready/scarf_cloth_02.ogg"
      ]
    },
    "DLG_MESSENGER_RULES_18": {
      "text": "你把围巾重新绕回脖子上。上面还有他的体温。",
      "assets": [
        "ready/scarf_cloth_01.ogg",
        "ready/scarf_cloth_02.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_19": {
      "text": "他递过来一只水壶，壶身上錾着一对黄铜翅膀。",
      "assets": [
        "ready/flask_handover.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_21": {
      "text": "你接过来。手指冷得厉害，黄铜摸上去竟有点烫。",
      "assets": [
        "ready/flask_handover.ogg"
      ]
    },
    "DLG_MESSENGER_EDGE_CHOICE_STONE_1": {
      "text": "你的手握住一块石头。冰凉，小得派不上用场。",
      "assets": [
        "ready/stone_pickup_small.ogg"
      ]
    }
  },
  "mandatory_context_rules": [
    "Film has its own soundtrack: never layer these cues over existing video.",
    "Opening snow belongs to approach/name-entry and initial snow-to-soft-ground transition only. RULES_08 awaits first frost, so ongoing forest footsteps must not crunch snow.",
    "EDGE_01 and EDGE_27 use the same single dog bark, still behind the listener. The second is clearer/louder; never continuous barking.",
    "EDGE_04 attenuates exposed gusts into sheltered forest. EDGE_05 stops footsteps and movement.",
    "EDGE_19/21: receiving/holding flask, not pouring or drinking. EDGE_20 is an invitation, not a performed action.",
    "EDGE_29 describes future stream route: only distant creek ambience, no water footsteps until the actual first_forest exploration action.",
    "Actual first_forest exploration is 8 seconds of shallow-water travel; later badger_track is 6 seconds of damp grass/soil travel, not water or snow.",
    "RULES_02 reports dogs diverted: no new bark. RULES_07 selects a tiny foliage pluck. RULES_17 is an actual departing run.",
    "Most dialogue lines remain quiet. Trigger once per newly entered line/branch; never retrigger because of reflow, save/load reconstruction or settings changes.",
    "Wind/foley-led silence is the preferred pursuit score. No suitable new licensed tension music has been auditioned; do not repurpose cozy loops."
  ],
